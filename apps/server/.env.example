PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
# The database name at the end (codepulse) is created automatically on first write.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/codepulse?retryWrites=true&w=majority

# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# GitHub App — for Check Runs on PRs (https://github.com/settings/apps)
# GITHUB_APP_PRIVATE_KEY holds the full PEM; in a single-line .env, escape its
# newlines as literal \n (they are restored at runtime).
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# GitHub App webhook secret — must match the secret configured on the App.
# Used to verify the x-hub-signature-256 HMAC on incoming webhooks.
WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret

# Frontend URL for redirect after OAuth
CLIENT_URL=http://localhost:3000

# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Sandbox — build the image first:
#   docker build -t codepulse-sandbox:latest ./docker/sandbox
SANDBOX_IMAGE=codepulse-sandbox:latest
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MAX_CODE_BYTES=65536
